version 100

cbb {
    base {
        depends []          # project-local dependencies
        depends_ex []       # external dependencies

        class "exe"

        includes [ ]
        source [ ]
        lib [ ]

        link [ ]
        link_shared [ ]

        compiler "g++"

        cc_args [ ]
        ld_args [ ]

        out "test"
    }

    debug {
        cc_args ["-g3"]
    }

    release {
        cc_args ["-O2"]
    }
}

targets {
    glad {
        concat "cbb.base"

        compiler "gcc"

        class "static"

        source [ "src/glad/glad.c" ]

        includes [ "src/glad" ]

        cc_args ["-O2"]

        out "static/libglad.a"
    }
    
    glfw {
        concat "cbb.base"

        compiler "gcc"

        class "static"

        source [
            "glfw/src/*.c"
        ]

        includes [
            "glad/include" "glad/src"
        ]

        cc_args [
            "-DGLFW_BUILD_X11"
        ]

        out "static/libglfw.a"
    }

    library {
        concat "cbb.base"

        depends_ex [
            {
                path "cml-lang/cml_lang.cml"
                target "shared"
            }

            {
                path "flac/default.cml"
                target "shared"
            }

            {
                path "src/lua/default.cml"
                target "shared"
            }
        ]

        class "shared"

        includes [
            "." "src"
            "cml-lang" "cml-lang/include"
            "cml-lang/hotchlib/include"
            "include/bitum" "include"
            "flac/include" "flac/src/libFLAC/include"
        ]

        source [
            "src/engine/*.cpp"
            "src/ui/*.cpp"
        ]

        lib [
            "cml-lang"
            "cml-lang/hotchlib"
        ]

        cc_args ["-std=c++17" "-fno-exceptions"]

        out "game/bin/libbitum.so"
    }

    main {
        concat "cbb.base"

        depends [
            "library"
            "glad"
            "glfw"
        ]

        source [
            "src/main/*.cpp"
        ]
        
        includes [
            "src/glad"
            "glad/include"

            "." "src/main" "src"
            "include" "include/bitum"
            "cml-lang/hotchlib/include"
            "cml-lang/hotchlib/include/hlib"
            "cml-lang/hotchlib/src"
        ]

        ld_args ["-Wl,-rpath,'$ORIGIN/bin'"]
        
        link [
            "libhotch.so"
            "libcml.so"
            "libflac.so"
            "libbitum.so"
            "liblua.so"

            "libglad.a"
            "libglfw.a"
        ]

        cc_args ["-std=c++17" "-fno-exceptions"]

        exec {
            init [
                {
                    command "move"
                    args ["cml-lang/libcml.so" "game/bin/libcml.so"]
                }

                {
                    command "move"
                    args ["cml-lang/hotchlib/libhotch.so" "game/bin/libhotch.so"]
                }

                {
                    command "move"
                    args ["flac/libflac.so" "game/bin/libflac.so"]
                }

                {
                    command "move"
                    args ["src/lua/liblua.so" "game/bin/liblua.so"]
                }
            ]
        }

        lib [
            "game/bin"
            "static"
        ]

        out "game/bitum"
    }
}
